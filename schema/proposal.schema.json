{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plebly.fund/schema/proposal.json",
  "title": "PleblyProposal",
  "type": "object",
  "required": ["title", "status", "deliverable", "verification", "out_of_scope", "submission_fee_txid"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "proposal_type": {
      "type": "string",
      "enum": ["bounty", "direct"],
      "default": "bounty",
      "description": "bounty = open claim; direct = proposer is recipient (no claim step)"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 40 },
      "maxItems": 12,
      "description": "Suggested vocabulary plus freeform tags"
    },
    "parent_initiative": {
      "type": ["string", "null"],
      "maxLength": 200,
      "description": "Optional parent initiative label (e.g. Commons thread)"
    },
    "delivery_window_ends_at": {
      "type": ["string", "null"],
      "description": "ISO timestamp — direct proposals only"
    },
    "status": {
      "type": "string",
      "enum": [
        "pr_open", "unindexed", "listed", "declined", "declined_fundable",
        "funding", "underfunded", "claimable", "claimed", "in_review",
        "rejected", "completed", "abandoned_vote", "refunding", "redirected"
      ]
    },
    "deliverable": { "type": "string", "minLength": 20 },
    "verification": { "type": "string", "minLength": 20 },
    "out_of_scope": { "type": "string", "minLength": 3 },
    "target_sats": { "type": ["integer", "null"], "minimum": 0 },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["deliverable", "verification", "out_of_scope", "allocation_sats", "deadline"],
        "properties": {
          "id": { "type": "string" },
          "deliverable": { "type": "string", "minLength": 10 },
          "verification": { "type": "string", "minLength": 10 },
          "out_of_scope": { "type": "string" },
          "allocation_sats": { "type": "integer", "minimum": 1 },
          "deadline": { "type": "string", "minLength": 4 },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Prior milestone ids in this proposal (Q11), e.g. m1"
          }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "description": "Blocking dependencies on other initiatives (Plebly or external)",
      "items": {
        "type": "object",
        "required": ["kind", "label"],
        "properties": {
          "kind": { "type": "string", "enum": ["plebly", "external"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "ref": { "type": "string", "maxLength": 500 },
          "note": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "related_work": {
      "type": "array",
      "description": "Non-blocking external work / prior art with links",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "url": {
            "type": "string",
            "minLength": 12,
            "maxLength": 500,
            "pattern": "^https://"
          },
          "note": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "escrow_address": { "type": ["string", "null"] },
    "escrow_index": { "type": ["integer", "null"], "minimum": 0 },
    "submission_fee_txid": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "cover_image": { "type": ["string", "null"] },
    "proposer": {
      "type": "object",
      "properties": {
        "username": { "type": ["string", "null"] },
        "github": { "type": ["string", "null"] },
        "nostr": { "type": ["string", "null"] },
        "x": { "type": ["string", "null"] }
      }
    },
    "created_at": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "target_sats": { "type": "integer", "minimum": 1000000 } },
        "required": ["target_sats"]
      },
      "then": {
        "properties": { "milestones": { "type": "array", "minItems": 1 } }
      }
    }
  ]
}
