{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plebly.fund/schema/proposal.json",
  "title": "PleblyProposal",
  "type": "object",
  "required": ["title", "status", "deliverable", "verification", "out_of_scope", "submission_fee_txid"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "status": {
      "type": "string",
      "enum": [
        "pr_open", "unindexed", "listed", "declined", "declined_fundable",
        "funding", "underfunded", "claimable", "claimed", "in_review",
        "rejected", "completed", "abandoned_vote", "refunding", "redirected"
      ]
    },
    "deliverable": { "type": "string", "minLength": 20 },
    "verification": { "type": "string", "minLength": 20 },
    "out_of_scope": { "type": "string", "minLength": 3 },
    "target_sats": { "type": ["integer", "null"], "minimum": 0 },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["deliverable", "verification", "out_of_scope", "allocation_sats", "deadline"],
        "properties": {
          "id": { "type": "string" },
          "deliverable": { "type": "string", "minLength": 10 },
          "verification": { "type": "string", "minLength": 10 },
          "out_of_scope": { "type": "string" },
          "allocation_sats": { "type": "integer", "minimum": 1 },
          "deadline": { "type": "string", "minLength": 4 },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "escrow_address": { "type": ["string", "null"] },
    "escrow_index": { "type": ["integer", "null"], "minimum": 0 },
    "submission_fee_txid": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "proposer": { "type": "object" },
    "created_at": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "target_sats": { "type": "integer", "minimum": 1000000 } },
        "required": ["target_sats"]
      },
      "then": {
        "properties": { "milestones": { "type": "array", "minItems": 1 } }
      }
    }
  ]
}
